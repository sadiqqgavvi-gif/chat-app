# Only needed when the API is hosted on a different domain than the
# client (for example client on Vercel, API on Back4app). When unset, the
# client talks to its own origin (/api), which works in development and
# when the server serves the built client.
VITE_API_URL=https://your-api.example.com/api
VITE_SOCKET_URL=https://your-api.example.com

# Optional: custom STUN/TURN servers for voice and video calls (JSON).
# VITE_ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
