# MongoDB connection string. Leave unset in development to use the
# built-in local database stored in server/.data.
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/chat-app

# Long random string used to sign login tokens. Required in production.
JWT_SECRET=change-me-to-a-long-random-string

PORT=5000

# Origin(s) of the web client, comma separated. Not needed when this
# server also serves the built client.
CLIENT_URL=http://localhost:5173
